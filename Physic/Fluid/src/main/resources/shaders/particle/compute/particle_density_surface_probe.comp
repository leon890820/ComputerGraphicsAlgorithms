#version 430

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

uniform sampler3D densityTexture;
uniform vec3 boundsCenter;
uniform vec3 boundsSize;
uniform vec3 rayOrigin;
uniform vec3 rayDirection;
uniform float isoLevel;
uniform float maxDistance;
uniform int probeSteps;

layout(std430, binding = 0) buffer SurfaceProbeResult {
    vec4 Result;
};

float sampleDensity(vec3 worldPosition) {
    vec3 uvw = ((worldPosition - boundsCenter) / boundsSize) + vec3(0.5);
    return textureLod(densityTexture, clamp(uvw, 0.0, 1.0), 0.0).x;
}

float interpolateIsoDistance(float previousDistance, float distance, float previousDensity, float density) {
    float denom = density - previousDensity;
    if (abs(denom) < 0.0001) {
        return distance;
    }

    float t = (isoLevel - previousDensity) / denom;
    return mix(previousDistance, distance, clamp(t, 0.0, 1.0));
}

void main() {
    float previousDistance = 0.0;
    float previousDensity = sampleDensity(rayOrigin);
    bool wasInside = previousDensity >= isoLevel;
    bool hasEnteredSurface = wasInside;
    float lastInsideDistance = wasInside ? 0.0 : -1.0;

    for (int i = 1; i <= probeSteps; i++) {
        float distance = maxDistance * float(i) / float(max(probeSteps, 1));
        float value = sampleDensity(rayOrigin + rayDirection * distance);
        bool isInside = value >= isoLevel;

        if (isInside) {
            hasEnteredSurface = true;
            lastInsideDistance = distance;
        } else if (wasInside && hasEnteredSurface) {
            float surfaceDistance = interpolateIsoDistance(previousDistance, distance, previousDensity, value);
            Result = vec4(surfaceDistance, 1.0, value, 0.0);
            return;
        }

        previousDistance = distance;
        previousDensity = value;
        wasInside = isInside;
    }

    if (lastInsideDistance >= 0.0) {
        Result = vec4(lastInsideDistance, 1.0, previousDensity, 0.0);
        return;
    }

    Result = vec4(0.0, 0.0, previousDensity, 0.0);
}
