#version 430

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

uniform sampler3D SourceDensityVolume;
layout(rgba32f, binding = 0) uniform writeonly image3D SmoothedDensityVolume;

float weight1D(int offset) {
    return offset == 0 ? 2.0 : 1.0;
}

void main() {
    ivec3 voxel = ivec3(gl_GlobalInvocationID.xyz);
    ivec3 volumeSize = imageSize(SmoothedDensityVolume);

    if (any(greaterThanEqual(voxel, volumeSize))) {
        return;
    }

    vec4 sum = vec4(0.0);
    float weightSum = 0.0;

    for (int z = -1; z <= 1; z++) {
        for (int y = -1; y <= 1; y++) {
            for (int x = -1; x <= 1; x++) {
                ivec3 sampleVoxel = clamp(voxel + ivec3(x, y, z), ivec3(0), volumeSize - ivec3(1));
                vec3 uvw = (vec3(sampleVoxel) + 0.5) / vec3(volumeSize);
                float weight = weight1D(x) * weight1D(y) * weight1D(z);
                sum += textureLod(SourceDensityVolume, uvw, 0.0) * weight;
                weightSum += weight;
            }
        }
    }

    imageStore(SmoothedDensityVolume, voxel, sum / max(weightSum, 0.0001));
}
