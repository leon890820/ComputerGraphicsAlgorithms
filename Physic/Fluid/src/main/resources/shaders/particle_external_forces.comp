#version 430

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer Positions {
    vec4 PositionsData[];
};

layout(std430, binding = 1) buffer PredictedPositions {
    vec4 PredictedPositionsData[];
};

layout(std430, binding = 2) buffer Velocities {
    vec4 VelocitiesData[];
};

uniform int numParticles;
uniform float deltaTime;
uniform vec3 gravity;
uniform vec3 center;
uniform float concentration;

void main() {
    uint id = gl_GlobalInvocationID.x;

    if (id >= uint(numParticles)) {
        return;
    }

    vec3 position = PositionsData[id].xyz;
    vec3 velocity = VelocitiesData[id].xyz;

    velocity += gravity * deltaTime * 0.99;

    vec3 toCenter = center - position;
    float distanceScale = 1.0 / (length(toCenter) + 1.0);
    float dragT = mix(1.0, distanceScale * 0.1, concentration * 0.0002);
    velocity = mix(vec3(0.0), velocity, clamp(dragT, 0.0, 1.0));

    if (length(toCenter) > 0.0001) {
        velocity += concentration * deltaTime * distanceScale * normalize(toCenter);
    }

    VelocitiesData[id] = vec4(velocity, 0.0);
    PredictedPositionsData[id] = vec4(position + velocity * (1.0 / 120.0), 1.0);
}
