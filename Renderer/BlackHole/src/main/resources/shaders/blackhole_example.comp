#version 430

layout(local_size_x = 16, local_size_y = 16) in;
layout(rgba32f, binding = 0) uniform writeonly image2D outputImage;

uniform vec2 resolution;
uniform float time;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);

    if (pixel.x >= size.x || pixel.y >= size.y) {
        return;
    }

    vec2 uv = (vec2(pixel) + 0.5) / resolution;
    vec2 p = uv * 2.0 - 1.0;
    p.x *= resolution.x / resolution.y;

    float r = length(p);
    float angle = atan(p.y, p.x);
    float swirl = sin(angle * 8.0 - time * 2.0 + 8.0 / max(r, 0.08));
    float ring = smoothstep(0.42, 0.36, abs(r - 0.42));
    float disk = smoothstep(0.95, 0.12, r) * smoothstep(0.18, 0.34, r);
    float horizon = smoothstep(0.22, 0.16, r);

    vec3 diskColor = mix(vec3(1.0, 0.38, 0.08), vec3(0.2, 0.55, 1.0), 0.5 + 0.5 * swirl);
    vec3 color = diskColor * disk * (0.35 + ring * 2.2);
    color += vec3(0.02, 0.025, 0.04) * (1.0 - smoothstep(0.0, 1.3, r));
    color *= 1.0 - horizon;

    imageStore(outputImage, pixel, vec4(color, 1.0));
}
