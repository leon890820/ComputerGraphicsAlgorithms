#version 430

layout(local_size_x = 16, local_size_y = 16) in;
layout(rgba32f, binding = 0) uniform writeonly image2D outputImage;

uniform vec2 resolution;
uniform float time;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);

    if (pixel.x >= size.x || pixel.y >= size.y) {
        return;
    }

    vec2 uv = (vec2(pixel) + 0.5) / resolution;
    vec2 p = uv * 2.0 - 1.0;
    p.x *= resolution.x / resolution.y;

    float r = length(p);
    float angle = atan(p.y, p.x);
    float ring = smoothstep(0.025, 0.0, abs(r - 0.45));
    float disk = smoothstep(0.95, 0.12, r) * smoothstep(0.12, 0.24, r);
    float swirl = 0.5 + 0.5 * sin(angle * 10.0 - time * 2.0 + 3.0 / max(r, 0.04));
    float horizon = 1.0 - smoothstep(0.17, 0.23, r);

    vec3 warm = vec3(1.0, 0.36, 0.06);
    vec3 cool = vec3(0.15, 0.55, 1.0);
    vec3 color = mix(warm, cool, swirl) * disk;
    color += vec3(1.0, 0.82, 0.45) * ring;
    color *= 1.0 - horizon;
    color += vec3(0.015, 0.018, 0.03) * (1.0 - smoothstep(0.0, 1.35, r));

    imageStore(outputImage, pixel, vec4(color, 1.0));
}